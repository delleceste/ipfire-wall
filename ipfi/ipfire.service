[Unit]
Description=IPFire-Wall Kernel Module and Rules Manager
After=network-pre.target
Before=network.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment="LD_LIBRARY_PATH=/usr/local/lib"

# Start: load module, load rules
ExecStart=/usr/local/bin/ipfire -rc -user

# Stop: Systemd sends SIGTERM to the application automatically.
# The application captures it and prints a comforting message.
# We then try to remove the module. If a foreground instance is running,
# this will fail gracefully.
ExecStop=/sbin/modprobe -r ipfi

# Reload: send SIGHUP to the application, then remove and reload.
ExecReload=/usr/bin/kill -s HUP $MAINPID
ExecReload=/sbin/modprobe -r ipfi
ExecReload=/usr/local/bin/ipfire -rc -user

[Install]
WantedBy=multi-user.target
